# Пример конфигурации ИС «МосТранспорт». Скопируйте в .env и заполните значения.
# Соответствует ТЗ п. И.1 (развёртывание).

# ===== Приложение =====
DEBUG=false
HOST=0.0.0.0
PORT=8000
APP_VERSION=0.1.0

# ===== База данных =====
DATABASE_PATH=data/mostransport.db

# ===== API data.mos.ru (см. ТЗ Приложение К, п. К.2) =====
# Ключ получить на https://data.mos.ru/developers/selfregistration
# ВАЖНО: не коммитить файл .env в git.
DATAMOS_API_KEY=

# ===== API ГУП Мосгортранс (см. ТЗ Приложение К, п. К.1) =====
MOSGORTRANS_API_KEY=

# ===== Nominatim (геокодирование) =====
NOMINATIM_USER_AGENT=MosTransport/0.1 (educational project, MAI)

# ===== Параметры маршрутизации =====
MAX_WALK_DISTANCE_M=800
ROUTE_CACHE_SIZE=1000
GEOCODE_CACHE_SIZE=1000

# ===== Безопасность =====
RATE_LIMIT_PER_MINUTE=60

# ===== Логирование =====
LOG_LEVEL=INFO
